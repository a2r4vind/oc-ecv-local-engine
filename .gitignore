# Frontend (Tauri + React + Vite)
frontend/node_modules/
frontend/dist/
frontend/src-tauri/target/
frontend/src-tauri/binaries/*.exe
frontend/src-tauri/binaries/*-x86_64-*
frontend/src-tauri/gen/

# Backend (Python)
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.spyproject/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store

# Generic hygiene (carried over from Tauri default)
*.local
.idea
*.sw?

# PyInstaller build artifacts (regenerate via `pyinstaller`, don't commit)
backend/build/
backend/dist/
backend/*.spec

# Spyder project metadata (local IDE config, not project source)
.spyproject/

# Sample/test data files (regenerate via generate_sample_data.py or
# download_sample_real_data.py — don't commit binary data to git)
backend/real_sample_data/
backend/*.nc

# Batch test data (regenerate via download_batch_real_data.py)
backend/real_batch_data/

# caching
backend/cache/
# Real satellite data for Days 19-21 buffer/review ECV testing (regenerate
# via download_sst_sample.py / download_sss_sample.py / download_iop_sample.py
# / download_osvw_sample.py / download_ssh_sample.py)
backend/real_sst_data/
backend/real_sss_data/
backend/real_iop_data/
backend/real_osvw_data/
backend/real_ssh_data/

saved_exports/