# Frontend (Tauri + React + Vite)
frontend/node_modules/
frontend/dist/
frontend/src-tauri/target/
frontend/src-tauri/binaries/*.exe
frontend/src-tauri/binaries/*-x86_64-*
frontend/src-tauri/gen/

# Backend (Python)
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.spyproject/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.DS_Store

# Generic hygiene (carried over from Tauri default)
*.local
.idea
*.sw?

# PyInstaller build artifacts (regenerate via `pyinstaller`, don't commit)
backend/build/
backend/dist/
backend/*.spec

# Spyder project metadata (local IDE config, not project source)
.spyproject/

# Batch test data (regenerate via download_batch_real_data.py)
backend/real_batch_data/

# Sample/test data (regenerate via generate_*.py / download_*.py scripts —
# don't commit binary satellite/synthetic data to git). Moved to project-root
# test_data/ during Phase 5 (Day 43) to keep backend/ free of test fixtures
# ahead of PyInstaller/Tauri packaging.
test_data/

# caching
backend/cache/

saved_exports
tmp/

